# Variables de Entorno y Configuración Portable para DCSA-reproducibilidad
# Copie este archivo como '.env' o configure las variables en su sistema operativo/entorno Colab.

# ==============================================================================
# 1. DIRECTORIOS PRINCIPALES DEL REPOSITORIO
# ==============================================================================
# Raíz del repositorio DCSA-reproducibilidad (por defecto se resuelve de forma relativa)
# DCSA_PROJECT_ROOT=/ruta/a/DCSA-reproducibilidad

# Directorio de salida para tablas, figuras y artefactos generados (por defecto: $DCSA_PROJECT_ROOT/results)
# DCSA_RESULTS_DIR=/ruta/a/DCSA-reproducibilidad/results

# ==============================================================================
# 2. ENTRADAS DE DATOS CLÍNICOS ORIGINALES (RESTRINGIDAS POR PRIVACIDAD)
# ==============================================================================
# Directorio base donde residen las bases de datos primarias SQLite (si se dispone de acceso autorizado)
# DCSA_DATA_DIR=/ruta/a/datos_restringidos

# Rutas explícitas opcionales a las bases SQLite individuales:
# DCSA_SQLITE_NARR=/ruta/a/datos_restringidos/colab/narraciones_colab.sqlite
# DCSA_SQLITE_ITEMS=/ruta/a/datos_restringidos/escalas_completas_items.sqlite

# ==============================================================================
# 3. ENTRADAS PARA EL AUTOENCODER MULTIMODAL MFCA-N1
# ==============================================================================
# Ubicación del archivo de configuración de familias y cabezales
# DCSA_FAMILIES_CONFIG=/ruta/a/DCSA-reproducibilidad/src/autoencoder/config/familias.json

# Ubicación del archivo Parquet con embeddings semánticos precalculados (768 dimensiones)
# DCSA_EMBEDDINGS_PATH=/ruta/a/embeddings_semanales.parquet

# Directorio específico de salida para artefactos del autoencoder (modelos, tablas OOF, diagnósticos)
# DCSA_AE_OUTPUT_DIR=/ruta/a/DCSA-reproducibilidad/results/autoencoder

# Modo de ejecución del autoencoder: 'smoke' (2 épocas para verificación) | 'normal' (entrenamiento completo de 5 pliegues)
DCSA_MODO=normal

# Modo de arquitectura: 'multimodal_dual_recalibrado' (recomendado) | 'canonico_recalibrado' | 'compacto_parsimonioso'
DCSA_ARQ=multimodal_dual_recalibrado

# Flag para montar Google Drive automáticamente en entornos Colab (1 = sí, 0 = no)
DCSA_MOUNT_DRIVE=0
